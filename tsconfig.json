{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "e2e", "supabase/functions"],
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@deathempire/*": ["src/*"],
      "@deathempire/types/*": ["src/types/*"]
    }
  }
}
