# DeathEmpire Site - Environment Variables Template
# Copy to .env.local and fill in your values
# NEVER commit .env.local or any file with real secrets

# ============================================================
# Supabase (Public - safe for client bundle)
# ============================================================
# Project URL from Supabase Dashboard > Settings > API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key from Supabase Dashboard > Settings > API
PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ============================================================
# Supabase (Private - NEVER expose in PUBLIC_* or client)
# Configure ONLY in server/Edge Functions environment
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================================
# Upstash Redis (Private - Rate limiting, idempotency)
# Configure ONLY in Edge Functions environment
# ============================================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ============================================================
# QStash (Private - Scheduled jobs, cron)
# Configure ONLY in Edge Functions environment
# ============================================================
# QSTASH_TOKEN=your-token
# QSTASH_CURRENT_SIGNING_KEY=your-key
# QSTASH_NEXT_SIGNING_KEY=your-key

# ============================================================
# Optional Feature Flags
# ============================================================
# PUBLIC_MAINTENANCE=false