---
// BaseLayout.astro - Layout base para todas las páginas
import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector.astro';
import { en } from '../i18n/en';
import { es as esDict } from '../i18n/es';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: 'en' | 'es';
  enPath?: string;
  esPath?: string;
}

const {
  title,
  description: propDescription,
  ogImage = '/DeathEmpire/og-default.png',
  canonical,
  lang = 'en',
  enPath,
  esPath,
} = Astro.props;

const t = lang === 'es' ? esDict : en;
const description = propDescription ?? t.meta.defaultDescription;

const pageUrl = canonical || Astro.url.pathname;
const fullUrl = new URL(pageUrl, 'https://deathempire-network.github.io').href;
const fullOgImage = new URL(ogImage, 'https://deathempire-network.github.io').href;
const fullEn = enPath ? new URL(enPath, 'https://deathempire-network.github.io').href : undefined;
const fullEs = esPath ? new URL(esPath, 'https://deathempire-network.github.io').href : undefined;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';

const navItems = t.nav;

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const normHref = href.replace(/\/$/, '') || '/';
  if (normHref === '/DeathEmpire') {
    return normalizedPath === '/DeathEmpire' || normalizedPath === '';
  }
  return normalizedPath === normHref || normalizedPath.startsWith(normHref + '/');
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Básico -->
    <title>{title} | DeathEmpire</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />
    {fullEn && <link rel="alternate" hreflang="en" href={fullEn} />}
    {fullEs && <link rel="alternate" hreflang="es" href={fullEs} />}
    {fullEn && <link rel="alternate" hreflang="x-default" href={fullEn} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="DeathEmpire" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon (SVG para todos los tamaños - soporte moderno) -->
    <link rel="icon" type="image/svg+xml" href="/DeathEmpire/favicon.svg" />
    <link rel="alternate icon" href="/DeathEmpire/favicon.ico" />
    <link rel="apple-touch-icon" href="/DeathEmpire/favicon.svg" />

    <!-- Manifest -->
    <link rel="manifest" href="/DeathEmpire/site.webmanifest" />

    <!-- Scripts diferidos -->
    <script is:inline defer>
      // Tema - sin flash de contenido sin estilo
      (function() {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.add(prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class="page-{Astro.url.pathname.replace(/\//g, '-').replace(/^-|-$/g, '') || 'home'}">
    <!-- Skip link para accesibilidad -->
    <a href="#main-content" class="skip-link">{t.ui.skipToContent}</a>

    <!-- Header -->
    <header class="site-header" role="banner">
      <div class="container header-inner">
        <!-- Logo / Brand -->
        <a href={lang === 'es' ? '/DeathEmpire/es/' : '/DeathEmpire/'} class="site-logo" aria-label={t.header.homeLabel}>
          <span class="logo-icon" aria-hidden="true">⚔</span>
          <span class="logo-text">DeathEmpire</span>
        </a>

        <!-- Navegación principal -->
        <nav class="main-nav site-nav" role="navigation" aria-label={t.ui.mainNav}>
          <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label={t.ui.openMenu}>
            <span class="hamburger" aria-hidden="true"></span>
          </button>
          <ul id="nav-menu" class="nav-menu" role="menubar">
            {navItems.map(item => {
              const active = isCurrent(item.href);
              return (
                <li role="none">
                  <a
                    href={item.href}
                    role="menuitem"
                    class={`nav-link ${active ? 'active' : ''}`}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        {enPath && esPath && (
          <div class="header-lang">
            <LanguageSelector lang={lang} enPath={enPath} esPath={esPath} />
          </div>
        )}

        <!-- CTA desktop / header -->
        <div class="header-cta">
          <a href={t.header.ctaHref} class="btn btn-primary btn-sm">{t.header.cta}</a>
        </div>
      </div>
    </header>

    <!-- Mobile nav overlay -->
    <div class="nav-overlay" aria-hidden="true"></div>

    <!-- Main content central y legible -->
    <main id="main-content" role="main" class="site-main container">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer" role="contentinfo">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={lang === 'es' ? '/DeathEmpire/es/' : '/DeathEmpire/'} class="logo" aria-label={t.header.homeLabel}>
              <span class="logo-icon" aria-hidden="true">⚔</span>
              <span class="logo-text">DeathEmpire</span>
            </a>
            <p>{t.footer.tagline}</p>
          </div>

          <nav class="footer-nav" aria-label={t.footer.exploreTitle}>
            <h4>{t.footer.exploreTitle}</h4>
            <ul>
              {t.footer.explore.map(item => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>

          <nav class="footer-nav" aria-label={t.footer.projectTitle}>
            <h4>{t.footer.projectTitle}</h4>
            <ul>
              {t.footer.project.map(item => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>

          <nav class="footer-nav" aria-label={t.footer.connectTitle}>
            <h4>{t.footer.connectTitle}</h4>
            <ul>
              {t.footer.connect.map(item => (
                <li><a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>{t.footer.note}</p>
          <div class="footer-links">
            <a href="https://github.com/DeathEmpire-network" target="_blank" rel="noopener">GitHub</a>
            <span class="footer-lang">{t.footer.languageLabel}</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Back to top -->
    <button class="back-to-top" aria-label={t.ui.backToTop} title={t.ui.backToTop}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>
  </body>
</html>

<style>
  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: var(--color-charcoal);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: 600;
    z-index: 9999;
    transition: top var(--transition-fast);
  }
  .skip-link:focus {
    top: var(--space-4);
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: rgba(10, 10, 10, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: var(--space-3) 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text-primary);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .site-logo:hover,
  .site-logo:focus-visible {
    color: var(--color-gold-bright);
    text-decoration: none;
  }

  .logo-icon {
    font-size: var(--text-xl);
    color: var(--color-gold);
    filter: drop-shadow(0 0 8px rgba(201, 168, 107, 0.4));
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* Navegación */
  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-nav,
  .nav-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.65rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
    position: relative;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-gold);
    box-shadow: 0 0 8px rgba(201, 168, 107, 0.6);
    transition: width var(--transition-normal), transform var(--transition-normal);
    transform: translateX(-50%);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible,
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-gold-bright);
    background: rgba(201, 168, 107, 0.08);
    text-decoration: none;
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after,
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    width: calc(100% - 0.5rem);
  }

  .site-nav a[aria-current="page"],
  .site-nav a.active,
  .nav-link[aria-current="page"],
  .nav-link.active {
    color: var(--color-gold-bright);
    font-weight: 600;
    background: rgba(201, 168, 107, 0.12);
  }

  .site-nav a[aria-current="page"]::after,
  .site-nav a.active::after,
  .nav-link[aria-current="page"]::after,
  .nav-link.active::after {
    width: calc(100% - 0.5rem);
    background: var(--color-gold-bright);
    box-shadow: 0 0 10px rgba(232, 197, 138, 0.9);
  }

  .header-cta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header-lang {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .footer-lang {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 1080px) {
    .header-cta {
      display: none;
    }
    .site-nav,
    .nav-menu {
      gap: 0.35rem 0.5rem;
    }
    .nav-link {
      padding: 0.3rem 0.5rem;
      font-size: var(--text-xs);
    }
  }

  /* Nav toggle (mobile) */
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hamburger {
    position: relative;
    width: 20px;
    height: 2px;
    background: var(--color-text-primary);
    transition: background var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-text-primary);
    transition: transform var(--transition-normal);
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { bottom: -6px; }

  .nav-toggle[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .nav-toggle[aria-expanded="true"] .hamburger::before {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .nav-toggle[aria-expanded="true"] .hamburger::after {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  .header-cta-mobile {
    display: none;
  }

  /* Nav overlay */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: calc(var(--z-sticky) - 1);
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-normal);
  }

  .nav-overlay.visible {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile styles */
  @media (max-width: 820px) {
    .main-nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 290px;
      max-width: 85vw;
      background: var(--color-bg-secondary);
      border-left: 1px solid var(--color-border-default);
      padding: var(--space-8) var(--space-6) var(--space-6);
      transform: translateX(100%);
      transition: transform var(--transition-normal);
      z-index: var(--z-fixed);
      overflow-y: auto;
    }

    .main-nav.open {
      transform: translateX(0);
    }

    .site-nav,
    .nav-menu {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .nav-link {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
      border-radius: var(--radius-md);
      text-align: left;
    }

    .nav-link::after {
      display: none;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
      background: var(--color-bg-tertiary);
    }

    .nav-toggle {
      display: flex;
    }

    .header-cta-mobile {
      display: block;
    }

    .header-cta-mobile .btn {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-xs);
    }

    .nav-overlay.visible {
      display: block;
    }
  }

  /* Main content central y legible */
  .site-main {
    flex: 1;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    min-height: calc(100vh - 280px);
  }

  /* Footer */
  .site-footer {
    margin-top: auto;
  }

  /* Back to top */
  .back-to-top {
    box-shadow: var(--shadow-lg);
  }

  .back-to-top svg {
    transition: transform var(--transition-fast);
  }

  .back-to-top:hover svg {
    transform: translateY(-2px);
  }

  /* Page transitions */
  @media (prefers-reduced-motion: no-preference) {
    main > *:first-child {
      animation: fade-in-up 0.5s ease-out forwards;
    }
  }
</style>

<script is:inline>
  // Mobile navigation
  const navToggle = document.querySelector('.nav-toggle');
  const navMenu = document.querySelector('.main-nav');
  const navOverlay = document.querySelector('.nav-overlay');
  const navLinks = document.querySelectorAll('.nav-link');

  function closeNav() {
    navMenu?.classList.remove('open');
    navOverlay?.classList.remove('visible');
    navToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  function openNav() {
    navMenu?.classList.add('open');
    navOverlay?.classList.add('visible');
    navToggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  navToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
    isExpanded ? closeNav() : openNav();
  });

  navOverlay?.addEventListener('click', closeNav);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 820) closeNav();
    });
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav();
  });

  // Back to top
  const backToTop = document.querySelector('.back-to-top');
  const scrollThreshold = 300;

  window.addEventListener('scroll', () => {
    if (window.scrollY > scrollThreshold) {
      backToTop?.classList.add('visible');
    } else {
      backToTop?.classList.remove('visible');
    }
  });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>