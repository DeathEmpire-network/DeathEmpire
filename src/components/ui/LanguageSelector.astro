---
/**
 * LanguageSelector.astro - Selector de idioma EN / ES
 * Lleva a la ruta equivalente cuando existe; nunca a una página vacía.
 * Sin dependencias: usa <details> nativo para no añadir JavaScript.
 */
import './LanguageSelector.css';

interface Props {
  lang: 'en' | 'es';
  enPath: string;
  esPath: string;
}

const { lang, enPath, esPath } = Astro.props;
const label = lang === 'es' ? 'Seleccionar idioma' : 'Select language';
const current = lang === 'es' ? 'ES' : 'EN';
---

<details class="lang-selector">
  <summary class="lang-current" aria-label={label}>
    <span aria-hidden="true" class="lang-globe">◈</span>
    <span>{current}</span>
    <span aria-hidden="true" class="lang-caret">▾</span>
  </summary>
  <ul class="lang-menu" role="list">
    <li>
      <a href={enPath} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} class={lang === 'en' ? 'active' : ''}>
        {lang === 'en' ? '✓ English' : 'English'}
      </a>
    </li>
    <li>
      <a href={esPath} hreflang="es" aria-current={lang === 'es' ? 'true' : undefined} class={lang === 'es' ? 'active' : ''}>
        {lang === 'es' ? '✓ Español' : 'Español'}
      </a>
    </li>
  </ul>
</details>