---
import { chapters, tome } from '../data/book/tome1';
import { totalSpreadsFor } from '../data/book/spreads';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const isEs = lang === 'es';
const chapterRows = chapters.map((chapter) => ({
  chapter,
  pages: totalSpreadsFor(chapter.slug) * 2,
}));
const openingCount = chapterRows.reduce((total, row) => total + row.pages / 2, 0);
const pageCount = openingCount * 2;
const completeChapterCount = chapters.filter((chapter) => chapter.hasFullText).length;

const copy = isEs
  ? {
      eyebrow: 'EL ARCHIVO',
      title: 'Archivo de tomos',
      description: 'Crónicas ordenadas por temporada. Cada tomo abre como un registro de dos páginas.',
      volumeLabel: 'Tomo',
      season: 'Temporada 1',
      volumeTitle: tome.titleEs,
      subtitle: tome.subtitleEs,
      summary: 'Del esplendor anterior al maná al origen del Niño del Nivel 78: diez capítulos sobre el precio de sobrevivir.',
      chapters: 'Capítulos',
      pages: 'Páginas',
      openings: 'Aperturas',
      start: 'Comenzar a leer',
      fullText: 'narrativa completa',
      archiveRecord: 'ficha de archivo',
      contentsEyebrow: 'ÍNDICE DEL TOMO',
      contentsTitle: 'Capítulos',
      chapterLabel: 'Capítulo',
      canon: 'Canónico',
      inDevelopment: 'En desarrollo',
      read: 'Leer capítulo',
      openRecord: 'Abrir ficha',
      reading: 'de lectura',
      complete: 'Narrativa completa',
      footer: 'El índice y el total de páginas se calculan desde la paginación editorial del tomo.',
      home: 'Volver al inicio',
      world: 'Descubrir el Mundo',
    }
  : {
      eyebrow: 'THE ARCHIVE',
      title: 'Tome archive',
      description: 'Chronicles arranged by season. Each volume opens as a two-page record.',
      volumeLabel: 'Tome',
      season: 'Season 1',
      volumeTitle: tome.titleEn,
      subtitle: tome.subtitleEn,
      summary: 'From the age before mana to the Level 78 Child: ten chapters on the cost of survival.',
      chapters: 'Chapters',
      pages: 'Pages',
      openings: 'Openings',
      start: 'Begin reading',
      fullText: 'complete narrative',
      archiveRecord: 'archive record',
      contentsEyebrow: 'VOLUME INDEX',
      contentsTitle: 'Chapters',
      chapterLabel: 'Chapter',
      canon: 'Canon',
      inDevelopment: 'In development',
      read: 'Read chapter',
      openRecord: 'Open record',
      reading: 'read',
      complete: 'Complete narrative',
      footer: 'The contents and page count are calculated from the volume’s editorial pagination.',
      home: 'Back to home',
      world: 'Discover the World',
    };
---

<article class={`lore-archive lore-archive-${lang}`}>
  <header class="archive-heading">
    <p class="section-eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.description}</p>
  </header>

  <section class="archive-shelf" aria-label={copy.eyebrow}>
    <article class="archive-volume" aria-labelledby="archive-volume-title">
      <section class="archive-page archive-volume-page">
        <p class="archive-volume-number">{copy.volumeLabel} {String(tome.number).padStart(2, '0')} <span>·</span> {copy.season}</p>
        <p class="archive-volume-kicker">✦ {copy.eyebrow} ✦</p>
        <h2 id="archive-volume-title">{copy.volumeTitle}</h2>
        <p class="archive-volume-subtitle">{copy.subtitle}</p>
        <p class="archive-volume-summary">{copy.summary}</p>

        <dl class="archive-stats">
          <div>
            <dt>{copy.chapters}</dt>
            <dd>{chapters.length}</dd>
          </div>
          <div>
            <dt>{copy.pages}</dt>
            <dd>{pageCount}</dd>
          </div>
          <div>
            <dt>{copy.openings}</dt>
            <dd>{openingCount}</dd>
          </div>
        </dl>

        <a class="btn btn-dark archive-start" href={`/DeathEmpire/${isEs ? 'es/' : ''}lore/${chapters[0].slug}/`}>
          {copy.start} <span aria-hidden="true">→</span>
        </a>
        <p class="archive-volume-note">
          {completeChapterCount} {copy.fullText} · {chapters.length - completeChapterCount} {copy.archiveRecord}
        </p>
      </section>

      <section class="archive-page archive-contents-page" aria-labelledby="archive-contents-title">
        <header class="archive-contents-heading">
          <div>
            <p class="archive-contents-eyebrow">{copy.contentsEyebrow}</p>
            <h3 id="archive-contents-title">{copy.contentsTitle}</h3>
          </div>
          <p class="archive-range">01—{String(chapters.length).padStart(2, '0')}</p>
        </header>

        <ol class="archive-chapters">
          {chapterRows.map(({ chapter, pages }) => {
            const chapterTitle = isEs ? chapter.titleEs : chapter.titleEn;
            const chapterSubtitle = isEs ? chapter.subtitleEs : chapter.subtitleEn;
            const chapterSummary = isEs ? chapter.summaryEs : chapter.summaryEn;
            const period = isEs ? chapter.periodEs : chapter.periodEn;
            const href = `/DeathEmpire/${isEs ? 'es/' : ''}lore/${chapter.slug}/`;
            return (
              <li class="archive-chapter">
                <a class="archive-chapter-link" href={href} aria-label={`${copy.chapterLabel} ${chapter.order}: ${chapterTitle}`}>
                  <span class="archive-chapter-number">{String(chapter.order).padStart(2, '0')}</span>
                  <span class="archive-chapter-copy">
                    <span class="archive-chapter-meta">{period} · {chapter.hasFullText ? copy.complete : copy.archiveRecord}</span>
                    <span class="archive-chapter-title">{chapterTitle}</span>
                    <span class="archive-chapter-subtitle">{chapterSubtitle}</span>
                    <span class="archive-chapter-summary">{chapterSummary}</span>
                  </span>
                  <span class="archive-chapter-pages">
                    <strong>{pages}</strong>
                    <span>{copy.pages}</span>
                    {chapter.readingMinutes && <span>≈ {chapter.readingMinutes} {copy.reading}</span>}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>

        <footer class="archive-contents-footer">{copy.footer}</footer>
      </section>
    </article>
  </section>

  <footer class="archive-site-links">
    <a href={isEs ? '/DeathEmpire/es/' : '/DeathEmpire/'}>{copy.home}</a>
    <span aria-hidden="true">·</span>
    <a href={isEs ? '/DeathEmpire/es/world/' : '/DeathEmpire/world/'}>{copy.world}</a>
  </footer>
</article>

<style>
  .lore-archive {
    --archive-ink: #2a1a16;
    --archive-ink-soft: #5b3a29;
    --archive-rule: rgba(91, 58, 41, 0.27);
    --archive-paper: #e7d4a8;
    --archive-paper-shadow: rgba(91, 58, 41, 0.12);
  }

  .archive-heading {
    margin-bottom: var(--space-6);
  }

  .archive-heading h1 {
    margin-bottom: var(--space-2);
    letter-spacing: 0;
  }

  .archive-heading > p:last-child {
    max-width: 68ch;
    margin-bottom: 0;
  }

  .archive-shelf {
    display: grid;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    gap: var(--space-5);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--color-gold-muted) var(--color-bg-secondary);
    padding: 2px 2px var(--space-3);
  }

  .archive-volume {
    display: grid;
    grid-template-columns: minmax(270px, 0.76fr) minmax(0, 1.6fr);
    min-width: 0;
    min-height: 650px;
    overflow: hidden;
    border: 1px solid #5b3a29;
    border-radius: 10px;
    background: var(--archive-paper);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3), inset 0 0 0 5px rgba(91, 58, 41, 0.08);
    scroll-snap-align: start;
  }

  .archive-page {
    position: relative;
    min-width: 0;
    overflow: hidden;
    color: var(--archive-ink);
    background-color: var(--archive-paper);
    background-image:
      radial-gradient(ellipse at 12% 8%, rgba(255, 250, 235, 0.54), transparent 47%),
      radial-gradient(ellipse at 92% 88%, rgba(166, 124, 82, 0.17), transparent 43%),
      repeating-linear-gradient(0deg, transparent 0 30px, rgba(91, 58, 41, 0.025) 30px 31px);
  }

  .archive-volume-page {
    display: flex;
    flex-direction: column;
    padding: var(--space-8) clamp(1.5rem, 4vw, 3rem);
    border-right: 2px solid rgba(91, 58, 41, 0.34);
    box-shadow: inset -12px 0 18px var(--archive-paper-shadow);
  }

  .archive-volume-number,
  .archive-volume-kicker,
  .archive-contents-eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--archive-ink-soft);
  }

  .archive-volume-number {
    margin-bottom: auto;
  }

  .archive-volume-number span {
    padding-inline: var(--space-1);
    color: var(--color-gold-muted);
  }

  .archive-volume-kicker {
    margin: var(--space-8) 0 var(--space-3);
  }

  .archive-volume-page h2 {
    margin-bottom: var(--space-3);
    color: var(--archive-ink);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .archive-volume-subtitle {
    margin-bottom: var(--space-4);
    color: var(--archive-ink-soft);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .archive-volume-summary {
    margin-bottom: var(--space-8);
    color: var(--archive-ink);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .archive-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--archive-rule);
    margin: 0 0 var(--space-6);
    padding-block: var(--space-4);
  }

  .archive-stats > div + div {
    border-left: 1px solid var(--archive-rule);
    padding-left: var(--space-3);
  }

  .archive-stats dt {
    color: var(--archive-ink-soft);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .archive-stats dd {
    margin: var(--space-1) 0 0;
    color: var(--archive-ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
  }

  .archive-start {
    align-self: flex-start;
    flex-shrink: 0;
  }

  .archive-volume-note {
    margin: var(--space-4) 0 0;
    color: var(--archive-ink-soft);
    font-size: var(--text-sm);
  }

  .archive-contents-page {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-6) var(--space-4);
    box-shadow: inset 10px 0 18px var(--archive-paper-shadow);
  }

  .archive-contents-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--archive-rule);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .archive-contents-eyebrow {
    margin: 0 0 var(--space-1);
  }

  .archive-contents-heading h3 {
    margin: 0;
    color: var(--archive-ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: 0;
  }

  .archive-range {
    margin: 0;
    color: var(--archive-ink-soft);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .archive-chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    column-gap: var(--space-5);
    row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive-chapter {
    min-width: 0;
    border-bottom: 1px solid var(--archive-rule);
  }

  .archive-chapter-link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-2);
    min-height: 88px;
    padding: var(--space-2) 0;
    color: var(--archive-ink);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .archive-chapter-link:hover,
  .archive-chapter-link:focus-visible {
    color: var(--archive-ink);
    background: rgba(91, 58, 41, 0.07);
    text-decoration: none;
  }

  .archive-chapter-number {
    padding-top: 2px;
    color: #8b6845;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .archive-chapter-copy,
  .archive-chapter-pages {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .archive-chapter-meta,
  .archive-chapter-pages {
    color: var(--archive-ink-soft);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .archive-chapter-title {
    margin-top: 2px;
    color: var(--archive-ink);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .archive-chapter-subtitle {
    margin-top: 2px;
    color: var(--archive-ink-soft);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.25;
  }

  .archive-chapter-summary {
    display: -webkit-box;
    overflow: hidden;
    margin-top: var(--space-1);
    color: #4b382b;
    font-size: 0.92rem;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .archive-chapter-pages {
    align-items: end;
    min-width: 3.2rem;
    padding-top: 2px;
    text-align: right;
    white-space: nowrap;
  }

  .archive-chapter-pages strong {
    color: var(--archive-ink);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .archive-contents-footer {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--archive-ink-soft);
    font-size: var(--text-xs);
  }

  .archive-site-links {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .archive-volume {
      grid-template-columns: minmax(230px, 0.72fr) minmax(0, 1.4fr);
    }

    .archive-contents-page {
      padding-inline: var(--space-4);
    }

  }

  @media (max-width: 680px) {
    .archive-heading h1 {
      font-size: var(--text-2xl);
    }

    .archive-volume {
      grid-template-columns: minmax(0, 1fr);
    }

    .archive-volume-page {
      min-height: 410px;
      border-right: 0;
      border-bottom: 2px solid rgba(91, 58, 41, 0.34);
      box-shadow: inset 0 -10px 18px var(--archive-paper-shadow);
      padding: var(--space-6);
    }

    .archive-volume-number {
      margin-bottom: var(--space-4);
    }

    .archive-volume-kicker {
      margin-top: var(--space-4);
    }

    .archive-volume-summary {
      margin-bottom: var(--space-5);
    }

    .archive-contents-page {
      padding: var(--space-5);
    }

    .archive-chapters {
      grid-template-columns: 1fr;
    }

    .archive-chapter-link {
      min-height: 0;
      grid-template-columns: 1.8rem minmax(0, 1fr) auto;
    }

    .archive-chapter-summary {
      -webkit-line-clamp: 3;
    }
  }
</style>
