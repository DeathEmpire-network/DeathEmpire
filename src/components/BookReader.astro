---
/**
 * BookReader.astro - Tomo único con hoja de dos caras (HTML + CSS 3D + JS mínimo)
 * Arquitectura: escenario (perspective) > asamblea (preserve-3d) >
 * spread actual + spread destino + hoja temporal (front/back).
 * Sin JS: todas las aperturas apiladas y legibles, pager con anclas.
 * Sin dependencias. Texto siempre HTML real y seleccionable.
 */
import type { BookPage } from '../data/book/pages';

interface ChapterLink {
  href: string;
  label: string;
}

interface Props {
  lang: 'en' | 'es';
  spreads: Array<{ left: BookPage; right: BookPage }>;
  prevChapter: ChapterLink | null;
  nextChapter: ChapterLink | null;
  indexHref: string;
  indexLabel: string;
  pagingLabel: string;
  firstLabel: string;
  lastLabel: string;
  prevLabel: string;
  nextLabel: string;
  progressOf: (s: number, t: number) => string;
  depth: number;
}

const p = Astro.props;
const total = p.spreads.length;

function anchor(n: number): string {
  return `#opening-${n}`;
}

/** Render inline **bold** con escape. */
function renderInline(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return esc.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

function renderPage(page: BookPage): string {
  if (page.kind === 'cover') {
    return `<p class="leaf-tome">✦ ${page.tomeTitle} ✦</p>`
      + `<p><span class="leaf-edition">${page.editionBadge}</span></p>`
      + (page.editionNote ? `<p class="leaf-editionnote">${page.editionNote}</p>` : '')
      + `<p class="leaf-chapter">${page.chapterLabel}</p>`
      + `<h1 class="leaf-title" tabindex="-1" data-book-focus>${page.title}</h1>`
      + (page.subtitle ? `<p class="leaf-subtitle">${page.subtitle}</p>` : '')
      + `<div class="leaf-divider" aria-hidden="true"><span></span><span>⚔</span><span></span></div>`
      + `<p><span class="status-badge status-completed">${page.statusBadge}</span></p>`
      + `<p class="leaf-reading">◷ ${page.readingNote}</p>`;
  }
  if (page.kind === 'text') {
    return (page.continuationLabel ? `<p class="leaf-continued">${page.continuationLabel}</p>` : '')
      + page.paragraphs.map((para: string, i: number) => {
        const focus = i === 0 ? ' tabindex="-1" data-book-focus' : '';
        return para.startsWith('> ')
          ? `<blockquote${focus}>${renderInline(para.slice(2))}</blockquote>`
          : `<p${focus}>${renderInline(para)}</p>`;
      }).join('');
  }
  if (page.kind === 'record') {
    return `<h2 class="leaf-h2" tabindex="-1" data-book-focus>${page.title}</h2>`
      + `<p>${page.consequences}</p>`
      + `<h3 class="leaf-h3">${page.keysTitle}</h3>`
      + `<p>${page.keys.join(' · ')}</p>`
      + `<p><span class="status-badge status-completed">${page.statusBadge}</span> <span class="text-ink-soft">${page.period}</span></p>`
      + `<p class="leaf-source">${page.sourceLabel}: <code>${page.sourceFile}</code></p>`;
  }
  if (page.kind === 'next') {
    return `<div class="leaf-next">`
      + `<p class="leaf-tome">${page.kicker}</p>`
      + (page.nextHref
        ? `<h2 class="leaf-h2" tabindex="-1" data-book-focus>${page.nextTitle}</h2>`
        + (page.nextSubtitle ? `<p class="leaf-subtitle">${page.nextSubtitle}</p>` : '')
        + `<p><a href="${page.nextHref}" class="btn btn-dark btn-sm">${page.nextCta} →</a></p>`
        : `<p>${page.nextCta}</p>`)
      + `<div class="leaf-divider" aria-hidden="true"><span></span><span>✦</span><span></span></div>`
      + `<p><a href="${page.indexHref}">${page.indexCta}</a></p></div>`;
  }
  return `<div class="placeholder"><p class="placeholder-mark" aria-hidden="true">✦</p>`
    + `<h2 class="leaf-h2" tabindex="-1" data-book-focus>${page.title}</h2>`
    + `<p>${page.body}</p>`
    + (page.sourceFile ? `<p class="leaf-source">${page.sourceLabel}: <code>${page.sourceFile}</code></p>` : '')
    + `</div>`;
}

function prevTarget(n: number): string {
  return n > 1 ? anchor(n - 1) : (p.prevChapter?.href ?? p.indexHref);
}
function prevText(n: number): string {
  return n > 1 ? `${p.prevLabel} ${n - 1}` : (p.prevChapter?.label ?? p.indexLabel);
}
function nextTarget(n: number): string {
  return n < total ? anchor(n + 1) : (p.nextChapter?.href ?? p.indexHref);
}
function nextText(n: number): string {
  return n < total ? `${p.nextLabel} ${n + 1}` : (p.nextChapter?.label ?? p.indexLabel);
}
---

<nav class="book-crumb" aria-label={p.indexLabel}>
  <a href={p.indexHref}>← {p.indexLabel}</a>
</nav>

<div class="lore-book" id="loreBook" style={`--depth: ${p.depth}px`}>
  <div class="book-cover-back" aria-hidden="true"></div>
  <div class="book-stage" id="bookStage">
    <div class="book-assembly" id="bookAssembly">
      {p.spreads.map((spread, i) => (
        <div class="spread" id={`opening-${i + 1}`} data-spread={i + 1} data-total={total}>
          <section class="leaf"><div class="leaf-inner" set:html={renderPage(spread.left)} /></section>
          <section class="leaf"><div class="leaf-inner" set:html={renderPage(spread.right)} /></section>
        </div>
      ))}
      <div class="turn-leaf" id="turnLeaf" aria-hidden="true" hidden>
        <div class="turn-face turn-front"><div class="leaf-inner" id="turnFront"></div></div>
        <div class="turn-face turn-back"><div class="leaf-inner" id="turnBack"></div></div>
      </div>
    </div>
  </div>
  <div class="book-block" aria-hidden="true"></div>
  <div class="book-spine-outer" aria-hidden="true"><span>✦ DEATHEMPIRE ✦</span></div>
</div>

<p class="book-progress" role="status" aria-live="polite" id="bookProgress">{p.progressOf(1, total)}</p>

<nav class="book-paging" aria-label={p.pagingLabel} id="bookPaging" data-prev-label={p.prevLabel} data-next-label={p.nextLabel}>
  <span class="page-corner left">
    <a href={anchor(1)} class="btn btn-outline btn-sm" data-book-first aria-label={p.firstLabel}>«</a>
    <a href={prevTarget(1)} class="btn btn-outline" data-book-prev aria-label={prevText(1)}>← {prevText(1)}</a>
  </span>
  <span class="page-corner right">
    <a href={nextTarget(1)} class="btn btn-outline" data-book-next aria-label={nextText(1)}>{nextText(1)} →</a>
    <a href={anchor(total)} class="btn btn-outline btn-sm" data-book-last aria-label={p.lastLabel}>»</a>
  </span>
</nav>

<script is:inline>
(function () {
  function ready(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }
  ready(function () {
    document.documentElement.classList.add('js');
    var book = document.getElementById('loreBook');
    if (!book) return;
    var spreads = Array.prototype.slice.call(book.querySelectorAll('.spread'));
    var total = spreads.length;
    if (!total) return;
    var leaf = document.getElementById('turnLeaf');
    var front = document.getElementById('turnFront');
    var back = document.getElementById('turnBack');
    var progress = document.getElementById('bookProgress');
    var paging = document.getElementById('bookPaging');
    var basePrevLabel = paging.getAttribute('data-prev-label') || 'Previous';
    var baseNextLabel = paging.getAttribute('data-next-label') || 'Next';
    var baseTemplate = progress.textContent;
    var current = 1;
    var pending = 1;
    var isTurning = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var finishedTimer = 0;

    function template(n) {
      var m = baseTemplate.match(/^(.*)(\d+)\s+(of|de)\s+(\d+)(.*)$/);
      if (m) return m[1] + n + ' ' + m[3] + ' ' + total + m[5];
      return 'Opening ' + n + ' of ' + total;
    }

    function leafInner(spreadEl, side) {
      var leaves = spreadEl.querySelectorAll('.leaf-inner');
      return leaves[side === 'left' ? 0 : 1];
    }

    function show(n) {
      spreads.forEach(function (el, i) {
        if (i + 1 === n) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });
      book.setAttribute('data-current', String(n));
      progress.textContent = template(n);
      var prev = paging.querySelector('[data-book-prev]');
      var next = paging.querySelector('[data-book-next]');
      if (n > 1) {
        prev.setAttribute('href', '#opening-' + (n - 1));
        prev.setAttribute('aria-label', basePrevLabel + ' ' + (n - 1));
        prev.textContent = '← ' + basePrevLabel + ' ' + (n - 1);
      }
      if (n < total) {
        next.setAttribute('href', '#opening-' + (n + 1));
        next.setAttribute('aria-label', baseNextLabel + ' ' + (n + 1));
        next.textContent = baseNextLabel + ' ' + (n + 1) + ' →';
      }
      current = n;
    }

    function focusSpread() {
      var h = book.querySelector('.spread:not([hidden]) [data-book-focus]');
      if (h) h.focus({ preventScroll: false });
    }

    function finishTurn() {
      if (!isTurning) return;
      isTurning = false;
      window.clearTimeout(finishedTimer);
      leaf.className = 'turn-leaf';
      leaf.hidden = true;
      show(pending);
      var active = spreads[pending - 1];
      if (!reduceMotion && active) {
        active.classList.add('page-enter');
        setTimeout(function () { active.classList.remove('page-enter'); }, 900);
      }
      try {
        var url = new URL(window.location.href);
        url.hash = 'opening-' + pending;
        window.history.replaceState(null, '', url.toString());
      } catch (e) {}
      focusSpread();
    }

    function onAnimationEnd(ev) {
      if (ev.target !== leaf || ev.animationName === 'turn-fade') { finishTurn(); return; }
      finishTurn();
    }
    leaf.addEventListener('animationend', onAnimationEnd);

    function turnTo(n, dir) {
      if (isTurning || n < 1 || n > total || n === current) return;
      pending = n;
      var fromEl = spreads[current - 1];
      var toEl = spreads[n - 1];
      if (reduceMotion) {
        show(n);
        try {
          var url = new URL(window.location.href);
          url.hash = 'opening-' + n;
          window.history.replaceState(null, '', url.toString());
        } catch (e) {}
        focusSpread();
        return;
      }
      isTurning = true;
      // Destino detrás: visible bajo la hoja durante el giro.
      toEl.removeAttribute('hidden');
      if (dir === 'next') {
        front.innerHTML = leafInner(fromEl, 'right').innerHTML;
        back.innerHTML = leafInner(toEl, 'left').innerHTML;
        leaf.className = 'turn-leaf show from-right';
      } else {
        front.innerHTML = leafInner(fromEl, 'left').innerHTML;
        back.innerHTML = leafInner(toEl, 'right').innerHTML;
        leaf.className = 'turn-leaf show from-left';
      }
      leaf.hidden = false;
      // Seguridad: si animationend no llega, finalizar igualmente.
      window.clearTimeout(finishedTimer);
      finishedTimer = window.setTimeout(finishTurn, 750);
    }

    paging.addEventListener('click', function (ev) {
      var a = ev.target.closest('a');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      var m = href.match(/#opening-(\d+)$/);
      if (!m) return; // chapter/index links navigate normally
      ev.preventDefault();
      var n = parseInt(m[1], 10);
      if (n === current) return;
      turnTo(n, n > current ? 'next' : 'prev');
    });

    (function init() {
      var m = (window.location.hash || '').match(/#opening-(\d+)$/);
      var n = m ? parseInt(m[1], 10) : 1;
      if (!(n >= 1 && n <= total)) n = 1;
      show(n);
    })();
  });
})();
</script>

<style is:global>
  /* Global: el contenido de las hojas se genera vía set:html. */
  .book-crumb {
    margin-bottom: var(--space-4);
  }
  .book-crumb a {
    font-size: var(--text-sm);
  }
  /* Tomo físico único */
  .lore-book {
    --depth: 32px;
    position: relative;
    width: min(1180px, calc(100vw - 48px));
    margin-inline: auto;
    padding: 0 calc(var(--depth) + 10px) 14px 16px;
  }
  .book-cover-back {
    position: absolute;
    top: 10px;
    bottom: 24px;
    left: 6px;
    right: 6px;
    background: linear-gradient(135deg, #4a2c1a 0%, #2a1a12 60%, #1a0f0a 100%);
    border: 1px solid #6b4a2f;
    border-radius: 12px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    z-index: 0;
  }
  .book-block {
    position: absolute;
    z-index: 1;
    top: 20px;
    bottom: 34px;
    right: 8px;
    width: var(--depth);
    background: repeating-linear-gradient(
      90deg,
      #c29b62 0,
      #e5ca91 1px,
      #b68a51 2px,
      #e5ca91 3px
    );
    border-radius: 0 5px 5px 0;
    transform: skewY(-1.5deg);
    box-shadow: inset -2px 0 4px rgba(60, 35, 20, 0.4);
  }
  .book-spine-outer {
    position: absolute;
    z-index: 3;
    top: 10px;
    bottom: 24px;
    left: 0;
    width: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(90deg, #1a0f0a, #5b3a29 50%, #1a0f0a);
    border: 1px solid #6b4a2f;
    border-radius: 8px;
  }
  .book-spine-outer span {
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: #c9a86b;
    white-space: nowrap;
  }
  /* Escenario 3D: perspective aquí; SIN overflow en la cadena preserve-3d */
  .book-stage,
  #book,
  .book {
    position: relative;
    width: 100%;
    margin-inline: auto;
    perspective: 2400px;
    perspective-origin: 50% 50%;
    overflow: visible;
    z-index: 2;
  }
  .book-assembly {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
  }
  .spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    border: 1px solid #6b4a2f;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), 0 4px 14px rgba(0, 0, 0, 0.5);
    background: #e7d4a8;
  }
  .spread + .spread {
    margin-top: var(--space-8);
  }
  /* Con JS: solo la apertura activa es visible y el libro tiene caja fija. */
  .js .spread[hidden] {
    display: none;
  }
  .js .spread + .spread {
    margin-top: 0;
  }
  .js .spread {
    position: absolute;
    inset: 0;
  }
  .js .book-assembly {
    height: clamp(620px, 72vh, 780px);
  }
  .js .leaf-inner {
    height: 100%;
    overflow: hidden;
  }
  .leaf {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    color: #2a1a16;
    background-color: #e7d4a8;
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(255, 250, 235, 0.5), transparent 55%),
      radial-gradient(ellipse at 85% 90%, rgba(166, 124, 82, 0.25), transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(91, 58, 41, 0.05) 26px 27px);
  }
  .leaf:first-child {
    border-right: 2px solid #a67c52;
    background-image:
      radial-gradient(ellipse at 50% 0%, rgba(255, 250, 235, 0.55), transparent 55%),
      radial-gradient(ellipse at 90% 100%, rgba(166, 124, 82, 0.3), transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(91, 58, 41, 0.05) 26px 27px),
      linear-gradient(90deg, transparent 0%, transparent 96%, rgba(60, 35, 20, 0.35) 100%);
  }
  .leaf:last-child {
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(255, 250, 235, 0.5), transparent 55%),
      radial-gradient(ellipse at 85% 90%, rgba(166, 124, 82, 0.25), transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(91, 58, 41, 0.05) 26px 27px),
      linear-gradient(90deg, rgba(60, 35, 20, 0.35) 0%, transparent 4%);
  }
  /* Hoja temporal de dos caras */
  .turn-leaf {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 10;
    pointer-events: none;
    transform-style: preserve-3d;
    backface-visibility: visible;
  }
  .turn-leaf.from-right {
    right: 0;
    transform-origin: left center;
  }
  .turn-leaf.from-left {
    left: 0;
    transform-origin: right center;
  }
  .turn-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background-color: #e7d4a8;
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(255, 250, 235, 0.5), transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(91, 58, 41, 0.05) 26px 27px);
    box-shadow: 0 0 44px rgba(0, 0, 0, 0.5);
  }
  .turn-face.turn-front {
    border-left: 2px solid #a67c52;
  }
  .turn-leaf.from-left .turn-face.turn-front {
    border-left: none;
    border-right: 2px solid #a67c52;
  }
  .turn-face.turn-back {
    transform: rotateY(180deg);
  }
  .turn-leaf.show.from-right {
    animation: lore-turn-next 520ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .turn-leaf.show.from-left {
    animation: lore-turn-prev 520ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes lore-turn-next {
    0% { transform: rotateY(0deg); }
    45% { box-shadow: -18px 10px 34px rgba(0, 0, 0, 0.45); }
    100% { transform: rotateY(-180deg); }
  }
  @keyframes lore-turn-prev {
    0% { transform: rotateY(0deg); }
    45% { box-shadow: 18px 10px 34px rgba(0, 0, 0, 0.45); }
    100% { transform: rotateY(180deg); }
  }
  /* Tinta editorial: aparición escalonada, sin typewriter */
  /* Pluma en llamas: la tinta entra al rojo vivo y se enfría.
     Por bloques, nunca carácter por carácter (legibilidad y ritmo). */
  .page-enter .leaf-inner > *:nth-child(1) { animation: quill-write 420ms ease-out both; }
  .page-enter .leaf-inner > *:nth-child(2) { animation: quill-write 420ms ease-out 60ms both; }
  .page-enter .leaf-inner > *:nth-child(3) { animation: quill-write 420ms ease-out 120ms both; }
  .page-enter .leaf-inner > *:nth-child(4) { animation: quill-write 420ms ease-out 180ms both; }
  .page-enter .leaf-inner > *:nth-child(5) { animation: quill-write 420ms ease-out 240ms both; }
  .page-enter .leaf-inner > *:nth-child(6) { animation: quill-write 420ms ease-out 300ms both; }
  .page-enter .leaf-inner > *:nth-child(n+7) { animation: quill-write 420ms ease-out 340ms both; }
  @keyframes quill-write {
    from {
      opacity: 0;
      transform: translateY(6px);
      filter: blur(2px) brightness(1.7) sepia(1) saturate(2.5) hue-rotate(-25deg);
    }
    45% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0) brightness(1.3) sepia(0.55) saturate(1.8);
      text-shadow: 0 0 12px rgba(255, 122, 0, 0.65), 0 0 3px rgba(255, 200, 80, 0.8);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: none;
      text-shadow: none;
    }
  }
  .leaf-tome {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: #5b3a29;
    margin-bottom: var(--space-2);
  }
  .leaf-edition {
    display: inline-block;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: #2a1a16;
    border: 1px solid #a67c52;
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    margin-bottom: var(--space-2);
  }
  .leaf-editionnote {
    font-size: var(--text-xs);
    color: #2a1a16;
    border: 1px dashed #a67c52;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.8rem;
    margin-bottom: var(--space-3);
  }
  .leaf-chapter {
    font-size: var(--text-sm);
    color: #5b3a29;
    margin-bottom: var(--space-2);
  }
  .leaf-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1.15;
    color: #2a1a16;
    margin-bottom: var(--space-2);
  }
  .leaf-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: #2a1a16;
    margin-bottom: var(--space-3);
  }
  .leaf-h3 {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b3a29;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .leaf-subtitle {
    font-style: italic;
    color: #5b3a29;
  }
  /* Guardas geométricas: citas y títulos nunca se parten ni huerfanizan.
     Reserva inferior implícita: la auditoría e2e/book-geometry exige
     que cada bloque termine dentro de la caja útil (±1px). */
  .lore-book blockquote,
  .lore-book h1,
  .lore-book h2,
  .lore-book h3 {
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .leaf-continued {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b3a29;
    margin-bottom: var(--space-3);
  }
  /* Lectura: serif editorial, capitular, citas marcadas */
  .lore-book .leaf-inner > p {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.06rem;
    line-height: 1.75;
    color: #2a1a16;
    margin-bottom: 1em;
    hyphens: auto;
  }
  .lore-book .leaf-inner > p[data-book-focus]::first-letter {
    font-family: var(--font-display);
    font-size: 2.6em;
    line-height: 0.9;
    float: left;
    padding-right: 0.12em;
    color: #5b3a29;
  }
  .lore-book .leaf-inner > blockquote {
    margin: 1.2em 0;
    padding: 0.6em 0 0.6em 1rem;
    border-left: 3px solid #a67c52;
    background: rgba(91, 58, 41, 0.08);
