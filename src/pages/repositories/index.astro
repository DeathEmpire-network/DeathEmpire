---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Open Development Workspaces';
const description = 'DeathEmpire is developed in the open: follow progress, share ideas or explore the technical foundations.';
---

<BaseLayout title={title} description={description} lang="en" enPath="/DeathEmpire/repositories/" esPath="/DeathEmpire/es/repositories/">
  <article>
    <header>
      <p class="section-eyebrow">OPEN DEVELOPMENT</p>
      <h1>Open Development Workspaces</h1>
      <p>DeathEmpire is developed in the open. Anyone who wants to follow progress, share ideas or understand the technical foundations can explore the project workspaces.</p>
    </header>

    <section>
      <h2>Public Workspaces</h2>
      <div class="grid grid-2" style="margin-top: var(--space-6);">
        <article class="card">
          <div class="card-header"><h3>Global-Tracker</h3></div>
          <div class="card-body">
            <p>Coordination, releases and the global view of the ecosystem.</p>
            <a href="https://github.com/DeathEmpire-network/Global-Tracker" target="_blank" rel="noopener" class="btn btn-outline btn-sm">View on GitHub ↗</a>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>DeathEmpire Site</h3></div>
          <div class="card-body">
            <p>The public archive, the chronicles and this presentation of DeathEmpire.</p>
            <a href="https://github.com/DeathEmpire-network/DeathEmpire" target="_blank" rel="noopener" class="btn btn-outline btn-sm">View on GitHub ↗</a>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>Game Services</h3></div>
          <div class="card-body">
            <p>The services that sustain the project's systems: persistence, orchestration and auditing.</p>
            <span class="status-badge status-dev">Internal workspace</span>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>World Infrastructure</h3></div>
          <div class="card-body">
            <p>Internal tooling and configuration to operate test environments.</p>
            <span class="status-badge status-dev">Internal workspace</span>
          </div>
        </article>
      </div>
      <p class="note" style="margin-top: var(--space-6);">Internal workspaces stay private. Public ones are linked above when the project chooses to share them.</p>
    </section>

    <footer>
      <p><a href="/DeathEmpire/project/">Back to The Project</a> · <a href="/DeathEmpire/collaborate/">Collaborate</a></p>
    </footer>
  </article>
</BaseLayout>
