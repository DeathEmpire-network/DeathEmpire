---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'How DeathEmpire Is Being Built';
const description = 'A long-term project: a world with its own identity, systems designed to grow, and foundations kept stable as the community evolves.';
---

<BaseLayout title={title} description={description} lang="en" enPath="/DeathEmpire/architecture/" esPath="/DeathEmpire/es/architecture/">
  <article>
    <header>
      <p class="section-eyebrow">FOR TECHNICAL READERS</p>
      <h1>How DeathEmpire Is Being Built</h1>
      <p>DeathEmpire is being built as a long-term project: a world with its own identity, systems designed to grow, and foundations kept stable as the community evolves.</p>
    </header>
    <section>
      <h2>Coordination</h2>
      <p>A central workspace coordinates communication between repositories, documentation and releases.</p>
    </section>
    <section>
      <h2>Game Services</h2>
      <p>Central services sustain persistence, instance orchestration, authentication and network auditing — designed with per-service access controls.</p>
    </section>
    <section>
      <h2>Regional Servers</h2>
      <p>Regionalized servers carry the playable world, with dedicated extensions for entity synchronization.</p>
    </section>
    <section>
      <h2>Entry Proxy</h2>
      <p>A distributed proxy receives players and routes them through an instance registry.</p>
    </section>
    <section>
      <h2>Internal Communication</h2>
      <p>Internal services communicate over designed channels with access controls per service — so the world can grow without losing stability.</p>
    </section>
    <section>
      <h2>Presence</h2>
      <p>The system is designed to reflect network state through filtered public snapshots, without exposing sensitive information.</p>
    </section>
    <section>
      <h2>End-to-End Integration</h2>
      <p>End-to-end integration is not yet verified. <span class="status-badge status-dev">In development</span></p>
    </section>
    <footer>
      <p><a href="/DeathEmpire/project/">Back to The Project</a> · <a href="/DeathEmpire/status/">Development status</a></p>
    </footer>
  </article>
</BaseLayout>
