---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'DeathEmpire';
const description = 'An empire fractured by old loyalties, forbidden power, and the lingering corruption of Wild Mana.';
---

<BaseLayout title={title} description={description} lang="en" enPath="/DeathEmpire/" esPath="/DeathEmpire/es/">
  <article class="home-portal">
    <!-- Hero Section -->
    <header class="hero">
      <div class="hero-eyebrow">
        <span class="hero-badge">
          <span class="badge-icon" aria-hidden="true">✦</span>
          <span>AN INDEPENDENT DARK-FANTASY WORLD</span>
        </span>
      </div>

      <h1 class="hero-title">DEATHEMPIRE</h1>

      <div class="hero-divider" aria-hidden="true">
        <span class="divider-line"></span>
        <span class="divider-emblem">⚔</span>
        <span class="divider-line"></span>
      </div>

      <p class="hero-tagline">
        An empire fractured by old loyalties, forbidden power,
        and the lingering corruption of Wild Mana.
      </p>

      <div class="hero-cta">
        <a href="/DeathEmpire/lore/" class="btn btn-primary btn-lg">Explore the Lore</a>
        <a href="/DeathEmpire/world/" class="btn btn-secondary btn-lg">Discover the World</a>
      </div>

      <p class="hero-signature">In active development · Created by Kramsuiakari</p>

      <!-- Métricas / Estado del mundo -->
      <div class="hero-metrics" role="region" aria-label="World overview">
        <div class="metric-item">
          <span class="metric-value">5</span>
          <span class="metric-label">archive chapters</span>
        </div>
        <span class="metric-separator" aria-hidden="true">·</span>
        <div class="metric-item">
          <span class="metric-value">7</span>
          <span class="metric-label">known factions</span>
        </div>
        <span class="metric-separator" aria-hidden="true">·</span>
        <div class="metric-item">
          <span class="metric-value">3</span>
          <span class="metric-label">imperial chronicles</span>
        </div>
        <span class="metric-separator" aria-hidden="true">·</span>
        <div class="metric-item">
          <span class="status-badge status-in-progress">In active development</span>
          <span class="metric-label">project status</span>
        </div>
      </div>
    </header>

    <!-- Secciones Principales -->
    <section class="cards-section" aria-labelledby="cards-section-heading">
      <div class="section-header">
        <span class="section-eyebrow">THE ARCHIVE</span>
        <h2 id="cards-section-heading">A world shaped by memory, ruin, power and consequence</h2>
        <p class="section-subline">Enter through lore, factions and gameplay — then follow the chronicles of its making.</p>
      </div>

      <div class="cards-grid">
        <!-- 1. Lore -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">Narrative</span>
            <span class="card-meta">5 Chapters</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/lore/" class="card-link">Lore and Chapters</a>
          </h3>
          <p class="card-description">
            Five canonical chapters: the Era of Splendor, the Awakening of Mana, the Fallen Sky, the Beasts from Beyond and the Summoner's Heir.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">Explore lore</span>
            <span class="action-arrow">→</span>
          </div>
        </article>

        <!-- 2. Mundo y Facciones -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">World</span>
            <span class="card-meta">7 Factions</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/world/" class="card-link">World and Factions</a>
          </h3>
          <p class="card-description">
            <strong>7 documented factions</strong>: the Mana Inquisition, the Star Hunters, the Remnant Legions, the Wild Mana Cult, the Artisan Guild, the Free Survivors and the Swarm of the Space Beasts.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">Discover the world</span>
            <span class="action-arrow">→</span>
          </div>
        </article>

        <!-- 3. Gameplay -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">Experience</span>
            <span class="card-meta">Pillars</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/gameplay/" class="card-link">Gameplay</a>
          </h3>
          <p class="card-description">
            Combat and specialization, exploration and risk, factions and reputation, equipment and progression — every choice carries consequence.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">See gameplay</span>
            <span class="action-arrow">→</span>
          </div>
        </article>

        <!-- 4. Crónicas -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">Development</span>
            <span class="card-meta">Notes</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/chronicles/" class="card-link">Chronicles</a>
          </h3>
          <p class="card-description">
            Notes from the making of DeathEmpire: the archive, the foundations and the first glimpses of the old Empire.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">Read chronicles</span>
            <span class="action-arrow">→</span>
          </div>
        </article>

        <!-- 5. El Proyecto -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">Vision</span>
            <span class="card-meta">Project</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/project/" class="card-link">The Project</a>
          </h3>
          <p class="card-description">
            An independent dark-fantasy project in active development, created and led by Kramsuiakari. Private by default, open to meaningful collaboration.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">Discover the project</span>
            <span class="action-arrow">→</span>
          </div>
        </article>

        <!-- 6. Estado del desarrollo -->
        <article class="portal-card">
          <div class="card-eyebrow">
            <span class="card-tag">Progress</span>
            <span class="card-meta">Status</span>
          </div>
          <h3 class="card-title">
            <a href="/DeathEmpire/status/" class="card-link">Development Status</a>
          </h3>
          <p class="card-description">
            The world, its systems and its foundations are being shaped for future closed testing. Public availability has not yet been announced.
          </p>
          <div class="card-action" aria-hidden="true">
            <span class="action-text">Follow development</span>
            <span class="action-arrow">→</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Colaboración -->
    <footer class="home-footer">
      <div class="footer-cta-card">
        <h3>Build something lasting</h3>
        <p>DeathEmpire is developed independently and privately, but meaningful collaboration can take many forms: creative work, technical insight, testing and support.</p>
        <div class="footer-cta-buttons">
          <a href="/DeathEmpire/collaborate/" class="btn btn-secondary">Collaborate with DeathEmpire</a>
          <a href="/DeathEmpire/project/" class="btn btn-outline">Discover the project</a>
        </div>
      </div>
      <p class="disclaimer">DeathEmpire is in active development. It does not represent public server availability nor commercial affiliation with Mojang / Microsoft.</p>
    </footer>
  </article>
</BaseLayout>
