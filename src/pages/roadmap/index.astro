---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Roadmap of DeathEmpire';
const description = 'Milestones in plain language: world foundations, game systems, proving grounds, private alpha and public evolution.';
---

<BaseLayout title={title} description={description} lang="en" enPath="/DeathEmpire/roadmap/" esPath="/DeathEmpire/es/roadmap/">
  <article>
    <header>
      <p class="section-eyebrow">ROADMAP</p>
      <h1>Milestones</h1>
      <p>Where DeathEmpire is heading, in stages anyone can follow.</p>
    </header>

    <section>
      <h2>The Journey</h2>
      <div class="grid" style="margin-top: var(--space-6);">
        <article class="card">
          <div class="card-header"><h3>World Foundations</h3></div>
          <div class="card-body">
            <p>Define the identity, the lore and the core systems of the world.</p>
            <span class="status-badge status-completed">Advanced</span>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>Game Systems</h3></div>
          <div class="card-body">
            <p>Develop progression, exploration, factions and playable experiences.</p>
            <span class="status-badge status-in-progress">In Progress</span>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>Proving Grounds</h3></div>
          <div class="card-body">
            <p>Prepare stable environments for the first closed tests.</p>
            <span class="status-badge status-planned">Designed</span>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>Private Alpha</h3></div>
          <div class="card-body">
            <p>Invite a small community to play, observe and improve.</p>
            <span class="status-badge status-planned">Planned</span>
          </div>
        </article>
        <article class="card">
          <div class="card-header"><h3>Public Evolution</h3></div>
          <div class="card-body">
            <p>Expand content, stability and access gradually.</p>
            <span class="status-badge status-dev">Future</span>
          </div>
        </article>
      </div>
    </section>

    <footer>
      <p><a href="/DeathEmpire/project/">Back to The Project</a> · <a href="/DeathEmpire/status/">Development status</a></p>
    </footer>
  </article>
</BaseLayout>
