---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Roadmap de DeathEmpire';
const description = 'Fases de desarrollo y trazabilidad de características según FEATURE_REGISTRY de DeathEmpire.';
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>Roadmap de DeathEmpire</h1>
      <p>Fases estructuradas y trazabilidad técnica según el registro normativo <code>FEATURE_REGISTRY.md</code>.</p>
    </header>

    <section>
      <h2>Fases del Proyecto</h2>
      <div class="grid" style="margin-top: var(--space-6);">
        <article class="card">
          <div class="card-header">
            <h3>Fase 1: Fundación</h3>
          </div>
          <div class="card-body">
            <p>Infraestructura base, orquestación de repositorios, gRPC Backend, PostgreSQL y configuración de instancias distribuidas.</p>
            <span class="status-badge status-completed">Avanzado</span>
          </div>
        </article>

        <article class="card">
          <div class="card-header">
            <h3>Fase 2: Core Gameplay</h3>
          </div>
          <div class="card-body">
            <p>Sistemas de clases canónicas, roles, atributos (STR, STA, AGI, INT, DEX), balanceo de combate y penalizaciones por equipo.</p>
            <span class="status-badge status-in-progress">En Progreso</span>
          </div>
        </article>

        <article class="card">
          <div class="card-header">
            <h3>Fase 3: Economía</h3>
          </div>
          <div class="card-body">
            <p>Pipeline de refino en 4 etapas, forja de equipamiento, caravanas comerciales y sistema de casas de subastas regionales.</p>
            <span class="status-badge status-planned">Diseñado</span>
          </div>
        </article>

        <article class="card">
          <div class="card-header">
            <h3>Fase 4: Mundo</h3>
          </div>
          <div class="card-body">
            <p>Generación de terreno regional en Folia, DeathZone hostil, integración de 7 facciones y eventos de Maná salvaje.</p>
            <span class="status-badge status-planned">Planificado</span>
          </div>
        </article>

        <article class="card">
          <div class="card-header">
            <h3>Fase 5: Pulido y Validación</h3>
          </div>
          <div class="card-body">
            <p>Pruebas de carga masiva, auditoría de concurrencia y validación integral end-to-end de toda la red distribuida.</p>
            <span class="status-badge status-dev">Futuro</span>
          </div>
        </article>
      </div>
    </section>

    <footer>
      <p><a href="/DeathEmpire/">Volver al inicio</a></p>
    </footer>
  </article>
</BaseLayout>
