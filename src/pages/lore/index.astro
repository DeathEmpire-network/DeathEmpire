---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loreChapters } from '../../data/lore';

const title = 'Lore y Capítulos de DeathEmpire';
const description = 'Cinco capítulos canónicos del lore de DeathEmpire: La Era del Esplendor, El Despertar del Maná, El Cielo que Cayó, Las Bestias del Espacio y El Hijo del Invocador.';
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>Lore y Capítulos de DeathEmpire</h1>
      <p>Cinco capítulos canónicos normados por <code>LORE_CANON.md</code> como documento normativo.</p>
    </header>

    <section>
      <h2>Capítulos Canónicos</h2>
      <div class="grid" style="margin-top: var(--space-6);">
        {loreChapters.map(chapter => (
          <article class="card">
            <div class="card-header">
              <h3>{chapter.order}. {chapter.title}</h3>
              {chapter.subtitle && <p class="text-gold" style="font-size: var(--text-sm); margin-top: var(--space-1); margin-bottom: 0;">{chapter.subtitle}</p>}
            </div>
            <div class="card-body">
              <p>{chapter.summary}</p>
              <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-3);">
                {chapter.keywords.map(kw => (
                  <span class="status-badge status-dev">{kw}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="note" style="margin-top: var(--space-6);">Documento normativo principal: <code>LORE_CANON.md</code>.</p>
    </section>

    <footer>
      <p><a href="/DeathEmpire/">Volver al inicio</a></p>
    </footer>
  </article>
</BaseLayout>
