---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const title = 'Collaborate with DeathEmpire';
const description = 'DeathEmpire is private by default and open to meaningful collaboration: creative, technical, testing and support.';
---

<BaseLayout title={title} description={description} lang="en" enPath="/DeathEmpire/collaborate/" esPath="/DeathEmpire/es/collaborate/">
  <article>
    <header>
      <p class="section-eyebrow">COLLABORATE</p>
      <h1>Build something lasting</h1>
      <p>DeathEmpire is developed independently and privately, but meaningful collaboration can take many forms.</p>
    </header>

    <section>
      <h2>How You Can Contribute</h2>
      <div class="grid grid-2" style="margin-top: var(--space-6);">
        <article class="card">
          <div class="card-header"><h3>✒ Creative Work</h3></div>
          <div class="card-body"><p>Help shape the world, its stories and its visual identity: lore, writing, art and worldbuilding.</p></div>
        </article>
        <article class="card">
          <div class="card-header"><h3>⚙ Technical Collaboration</h3></div>
          <div class="card-body"><p>Share engineering experience, reviews or tooling ideas. <a href="/DeathEmpire/contributing/">Read the technical path</a>.</p></div>
        </article>
        <article class="card">
          <div class="card-header"><h3>🔮 Testing &amp; Feedback</h3></div>
          <div class="card-body"><p>Help detect friction, errors and opportunities before any alpha. Register your interest for future testing.</p></div>
        </article>
        <article class="card">
          <div class="card-header"><h3>🤝 Support &amp; Partnerships</h3></div>
          <div class="card-body"><p>Explore responsible ways to support the project. Official channels will be announced when ready.</p></div>
        </article>
      </div>
    </section>

    <section>
      <h2>A Note on Access</h2>
      <p>DeathEmpire is private by default. Showing interest does not grant access to internal code, infrastructure, servers or confidential materials. Every proposal is considered individually, with the minimum access needed defined only when appropriate.</p>
      <p>
        <a href="/DeathEmpire/project/" class="btn btn-secondary btn-sm">Discover the project</a>
        <a href="/DeathEmpire/chronicles/" class="btn btn-outline btn-sm">Follow the project</a>
      </p>
    </section>

    <footer>
      <p><a href="/DeathEmpire/">Back to home</a></p>
    </footer>
  </article>
</BaseLayout>
